# Copy this file to `.env` and fill in a real key. `.env` is gitignored — never commit it.

# OpenCode API key. This project authenticates through OpenCode, not a personal
# Anthropic key.
OPENCODE_API_KEY=<key here>

# Gateway base URL. A trailing /v1 is stripped automatically (the SDK appends
# /v1/messages itself). Defaults to https://opencode.ai/zen (see src/client.ts).
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# Model id to use. Falls back to the pinned default in src/client.ts when unset.
LLM_MODEL=minimax-m3

# Optional. Takes precedence over OPENAI_BASE_URL when both are set.
# OPENCODE_BASE_URL=https://opencode.ai/zen/go
