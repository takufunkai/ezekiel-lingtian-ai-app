# Copy this file to `.env` and fill in a real key. `.env` is gitignored — never commit it.

# OpenCode API key. This project authenticates through OpenCode, not a personal
# Anthropic key.
OPENCODE_API_KEY=your-opencode-key-here

# Optional. Gateway base URL. A trailing /v1 is stripped automatically (the SDK
# appends /v1/messages itself). Must be https. Defaults to https://opencode.ai/zen
# (see src/client.ts).
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# Optional. Model id to use; must be on the SUPPORTED_MODELS allowlist in
# src/client.ts. Falls back to the pinned default when unset.
# LLM_MODEL=minimax-m3

# Optional. Takes precedence over OPENAI_BASE_URL when both are set, and is not
# restricted to https (it is project-owned, so setting it is deliberate).
# OPENCODE_BASE_URL=https://opencode.ai/zen/go
