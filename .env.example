# Copy this file to `.env` and fill in a real key. `.env` is gitignored — never commit it.

# OpenCode API key. This project authenticates through OpenCode, not a personal
# Anthropic key.
OPENCODE_API_KEY=your-opencode-key-here

# Optional. Override the OpenCode gateway base URL.
# Defaults to https://opencode.ai/zen/v1 (see src/client.ts).
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
