# dependencies
node_modules/

# secrets — never commit a real key
.env
.env.*
!.env.example

# build output
dist/
build/
*.tsbuildinfo

# test / tooling caches
coverage/
.vitest/
.cache/

# agent worktrees — separate checkouts, never part of this tree
.claude/worktrees/

# gathered sets — retrieved source material written by `npm run gather`.
# Data, not fixtures: it is not reproducible, it carries no ground truth, and the
# committed corpus in examples/ stays the input the tests run against.
gathered/

# editors and OS
.DS_Store
Thumbs.db
*.log
out/
